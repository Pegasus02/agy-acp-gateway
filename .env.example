# agy-acp-gateway Configuration (.env.example)
# Copy to .env (for ./scripts/gw.sh) or deploy/.env (for Docker Compose).
# Do not commit your real .env file.

# === Basic Settings (most setups only edit these lines) ===

# Dedicated admin password protecting ONLY :18891 (WebUI Console, /api/*, /metrics).
# - Recommended for production: separates :18891 admin privileges from :18890 client API keys.
# - Accepts plaintext OR a pre-hashed "sha256:<64-hex>" digest (HTTP Basic Auth: any username + password).
# - When set, master AGY_API_KEYS and client keys are rejected (401) on :18891, and this password is
#   rejected (401) on :18890. Leave empty to fall back to AGY_API_KEYS for :18891 login.
# AGY_DASHBOARD_PASSWORD=
# AGY_DASHBOARD_PASSWORD_FILE=/data/dashboard_password.txt

# Master API keys (comma-separated) for :18890 APIs (and :18891 fallback when AGY_DASHBOARD_PASSWORD is unset).
# Append @acct:<id> or @group:<id> on clients to target one account or group.
# Dashboard-issued client keys (agy-ck-*, SHA-256 hashed in client_keys.json) only unlock :18890.
AGY_API_KEYS=sk-agy-replace-with-your-strong-master-key
# AGY_CLIENT_KEYS_FILE=/data/client_keys.json

# Listen address (127.0.0.1 on host; Docker Compose overrides to 0.0.0.0 inside container)
AGY_LISTEN_HOST=127.0.0.1

# AI API port (:18890) and Web admin console port (:18891)
AGY_GW_PORT=18890
AGY_DASH_PORT=18891

# Default proxy for the primary account (e.g. http://127.0.0.1:7890 or socks5://127.0.0.1:1080; empty = direct)
AGY_UPSTREAM_PROXY=


# === Advanced Defaults (optional, leave as-is unless tuning) ===

# Extra master keys file, CORS origins for :18890, and Google One credit fallback (0 or 1)
# AGY_API_KEYS_FILE=/data/api_keys.txt
AGY_CORS_ORIGINS=
AGY_USE_G1_CREDITS=0

# Multi-account config path, optional Resin static proxy pool, and multi-node dashboard peers
# AGY_INSTANCE_ID=primary
# AGY_INSTANCE_LABEL=Primary Account
# AGY_ACCOUNTS_FILE=/data/accounts.json
# AGY_PROXY_PRESETS_FILE=/data/proxy-presets.json
# AGY_RESIN_HOST=resin:2260
# AGY_RESIN_PROXY_TOKEN=
# AGY_DASHBOARD_PEERS=

# Custom paths to 900K-patched agy binary and optional unpatched agy binary for quota checks
# AGY_ACP_BIN=/path/to/agy-acp-gateway/bin/agy-acp-900k
# AGY_QUOTA_BIN=

# Worker limits: primary account max (8), global idle hot workers (8), and global burst ceiling (0 = auto from RAM)
AGY_MAX_LIVE_WORKERS=8
AGY_GLOBAL_IDLE_TARGET=8
AGY_GLOBAL_BURST_MAX_LIVE_WORKERS=0
# AGY_GLOBAL_MAX_LIVE_WORKERS=8
# AGY_MAX_CONCURRENT_PROMPTS=8

# Request timeouts in seconds: session idle (30m), max turn (12h), first token (6m), stream gap (3m)
AGY_PROMPT_IDLE_TIMEOUT_SEC=1800
AGY_PROMPT_MAX_DURATION_SEC=43200
AGY_PROMPT_FIRST_CHUNK_TIMEOUT_SEC=360
AGY_PROMPT_STREAM_IDLE_TIMEOUT_SEC=180

# Health-check worker limit and idle process hibernation timeout (seconds)
AGY_MAX_PROBE_WORKERS=1
AGY_IDLE_WORKER_TTL_SEC=180
AGY_ENGINE_IDLE_GRACE_SEC=180

# Container RAM thresholds (%) for evicting idle workers
AGY_MEM_PRESSURE_WARN_PCT=70
AGY_MEM_PRESSURE_HIGH_PCT=80

# Remote image cache (MiB), client tool-result wait timeout (s), tool-turn retries, and max body size (MiB)
AGY_IMAGE_CACHE_MAX_MB=16
AGY_PARKED_TTL_SEC=300
AGY_MAX_TOOL_RELAYS=2
AGY_MCP_TOOL_RESULT_MAX_BYTES=9600
AGY_MAX_BODY_MB=64
# AGY_TOOL_RELAY_SEC=55
# AGY_RUNAWAY_CR_MAX_CONSECUTIVE=4096

# Optional Go runtime memory overrides and manual plan tier (pro | ultra_5x | ultra)
# GOMEMLIMIT=256MiB
# GOGC=25
# AGY_CHILD_GATEWAY_GOMEMLIMIT=80MiB
# AGY_CHILD_GOMEMLIMIT=150MiB
# AGY_CHILD_GOGC=25
# AGY_ACCOUNT_PLAN_TIER_OVERRIDE=

# 5-hour tool safety check thresholds (normally switched live in :18891 UI: 80% / 88% / 93%)
AGY_MONITOR_TRIP_ROUTING=true
AGY_MONITOR_TRIP_HOP=true
AGY_MONITOR_BUDGET_SPREAD=true
AGY_MONITOR_SOFT_CAP_ULTRA=3300
AGY_MONITOR_DRAIN_CAP_ULTRA=4250
AGY_MONITOR_HARD_CAP_ULTRA=4800
AGY_MONITOR_SOFT_CAP_PRO=2100
AGY_MONITOR_DRAIN_CAP_PRO=2900
AGY_MONITOR_HARD_CAP_PRO=3400

# Slow-request disconnect grace (s), cache-miss warning header, tier fallback cooldown (s), and 400 WAF recovery
AGY_PREFILL_CANCEL_MIN_ELAPSED_SEC=30
AGY_PREFILL_CANCEL_GRACE_SEC=45
AGY_CACHE_WARN_MIN_TOKENS=80000
AGY_CACHE_WARN_STREAK=3
AGY_CAPACITY_FALLBACK_TTL_SEC=300
AGY_CAPACITY_FALLBACK_MAX_TTL_SEC=1800
AGY_WAF_AUTOBISECT=true
# AGY_WAF_RULES_FILE=/data/waf_rewrite_rules.json

# Model routing options, attachment size limits, text PDF extraction, and Gemini scanned PDF/audio/video
# AGY_DEFAULT_MODEL=gemini-4-carbon
# AGY_EXPOSE_TIER_MODELS=0
# AGY_ROUTE_CLAUDE_NAMES=0
AGY_MAX_IMAGES_GEMINI=200
AGY_MAX_IMAGES_CLAUDE=100
AGY_MAX_IMAGE_BYTES=10485760
AGY_MAX_PROMPT_IMAGE_BYTES=33554432
AGY_MAX_TEXT_FILE_BYTES=2097152
AGY_FETCH_IMAGES=true
AGY_PDF_TEXT_FASTPATH=1
AGY_MEDIA_RELAY=0
AGY_MEDIA_RELAY_MAX_BYTES=20971520
AGY_MEDIA_RELAY_MAX_FILES=3
AGY_MEDIA_RELAY_MAX_CONCURRENCY=1

# Log/conversation retention and optional host upgrader overrides
AGY_CONV_KEEP_DAYS=4
AGY_ACP_LOG_KEEP_DAYS=0
AGY_ACP_LOG_MAX_MB=64
AGY_APP_CONV_DIR=
# AGY_STATE_DB=/data/gateway.db
# AGY_GW_LOG=/data/logs/gateway.log
# AGY_LOG_MAX_MB=20
# AGY_UPGRADE_DIR=/data/upgrade
# AGY_VERIFY_DEFER_BACKOFF_SECS=900,1800,3600
# AGY_BLOCKED_VERSIONS=1.5.17,1.5.18
# AGY_SKIP_G5_MEDIA_CHECK=0
